<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the turret conversion on your own blueprints (Documents\My Games\Sprocket\Factions\PMC). No game or BepInEx needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\SprocketQoL\Conversion.cs" Link="Conversion.cs" />
    <Compile Include="..\SprocketQoL\AddonEdits.cs" Link="AddonEdits.cs" />
    <Compile Include="..\SprocketQoL\HoleRing.cs" Link="HoleRing.cs" />
    <Compile Include="..\SprocketQoL\MeshCut.cs" Link="MeshCut.cs" />
    <Compile Include="..\SprocketQoL\Fill.cs" Link="Fill.cs" />
    <Compile Include="..\SprocketQoL\FaceMerge.cs" Link="FaceMerge.cs" />
    <Compile Include="..\SprocketQoL\MeshPlans.cs" Link="MeshPlans.cs" />
    <Compile Include="..\SprocketQoL\Drawing.cs" Link="Drawing.cs" />
    <Compile Include="..\SprocketQoL\DrawingOptions.cs" Link="DrawingOptions.cs" />
    <Compile Include="..\SprocketQoL\GunAnnotationPreferences.cs" Link="GunAnnotationPreferences.cs" />
    <Compile Include="..\SprocketQoL\DrawingMounts.cs" Link="DrawingMounts.cs" />
    <Compile Include="..\SprocketQoL\Acceleration.cs" Link="Acceleration.cs" />
    <Compile Include="..\SprocketQoL\GizmoPicking.cs" Link="GizmoPicking.cs" />
    <Compile Include="..\SprocketQoL\BevelEdges.cs" Link="BevelEdges.cs" />
  </ItemGroup>
</Project>
